{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch",
  "version": "0.1.4",
  "identifier": "ai.watch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Watch",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "bloomstick",
    "category": "DeveloperTool",
    "shortDescription": "Watch - unofficial advanced UI wrapper for OpenCode",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
